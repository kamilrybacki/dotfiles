#!/usr/bin/env python3
"""Claude Code MCP `headersHelper` for the cellarette servers.

Claude Code runs this before connecting and passes the server URL in
CLAUDE_CODE_MCP_SERVER_URL. It prints a JSON object of HTTP headers:

- localhost (the lw-main :8788 aggregator): `{}`. That proxy rejects ANY
  Authorization header (400 invalid_profile_token / 401), so none is sent.
- the cellarette edge host: `{"Authorization": "Bearer <token>"}`, the token
  taken from $CELLARETTE_MCP_TOKEN or ~/.config/cellarette/token (written by
  cellarette-token-sync).
- any other host: refuse, so a redirected CELLARETTE_MCP_URL can never
  receive the token.

The token value is never written to stderr.
"""
import json
import os
import sys
from pathlib import Path
from urllib.parse import urlsplit

EDGE_HOST = "cellarette-mcp.kamilandrzejrybacki.dpdns.org"
LOCAL_HOSTS = {"localhost", "127.0.0.1", "::1"}


def token_file() -> Path:
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "cellarette" / "token"


def read_token() -> str:
    token = os.environ.get("CELLARETTE_MCP_TOKEN", "").strip()
    if token:
        return token
    try:
        return token_file().read_text().strip()
    except OSError:
        return ""


def fail(message: str) -> int:
    print(f"cellarette-headers: {message}", file=sys.stderr)
    return 1


def main() -> int:
    url = os.environ.get("CLAUDE_CODE_MCP_SERVER_URL", "")
    parts = urlsplit(url)
    host = (parts.hostname or "").lower()

    if host in LOCAL_HOSTS:
        print("{}")
        return 0
    if host != EDGE_HOST or parts.scheme != "https":
        return fail(f"refusing to send a token to {parts.scheme}://{host or '?'}")

    token = read_token()
    if not token or any(c.isspace() for c in token):
        return fail(f"no usable token: set CELLARETTE_MCP_TOKEN or run cellarette-token-sync ({token_file()})")
    print(json.dumps({"Authorization": f"Bearer {token}"}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
