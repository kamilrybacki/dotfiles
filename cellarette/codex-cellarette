#!/usr/bin/env bash
# Codex launcher for non-interactive parents (T3 Code, cron, IDEs) that never source ~/.bashrc.
# Codex's HTTP MCP auth only reads CELLARETTE_MCP_TOKEN (bearer_token_env_var); this loads it from
# the file cellarette-token-sync writes, without printing it, then execs the real codex.
set -euo pipefail
if [ -z "${CELLARETTE_MCP_TOKEN:-}" ]; then
  token_file="${XDG_CONFIG_HOME:-$HOME/.config}/cellarette/token"
  if [ -r "$token_file" ]; then
    CELLARETTE_MCP_TOKEN="$(tr -d '[:space:]' < "$token_file")"
    export CELLARETTE_MCP_TOKEN
  fi
fi
exec "${CODEX_BIN:-$HOME/.local/bin/codex}" "$@"
